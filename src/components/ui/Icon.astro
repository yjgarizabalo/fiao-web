---
/**
 * Ícono Ionicons en SVG en línea (ver src/lib/icons.ts). Decorativo por defecto
 * (aria-hidden); si el ícono es lo único que comunica algo, pasa `label`.
 */
import { icons, type IconName } from "@/lib/icons";

export interface Props {
  name: IconName;
  /** Tamaño en px (ancho = alto). */
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 512 512"
  width={size}
  height={size}
  fill="currentColor"
  class={`shrink-0 ${className}`}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={icons[name]}
/>
