---
import { navItems, footerContent } from "@/data/landing";
import StoreBadges from "@/components/ui/StoreBadges.astro";

const year = new Date().getFullYear();
---

<footer class="bg-ink-50 border-t border-border py-14">
  <div class="container flex flex-col gap-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
      <div class="flex flex-col gap-2">
        <img src="/images/logo/logo.png" alt="fiao" class="h-7 w-auto self-start" />
        <p class="text-ink-500 text-sm max-w-xs">{footerContent.tagline}</p>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-400">
          {footerContent.productHeading}
        </h3>
        <nav class="flex flex-col gap-2">
          {
            navItems.map((item) => (
              <a href={item.href} class="text-sm text-ink-600 hover:text-primary transition-colors">
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-400">
          {footerContent.downloadHeading}
        </h3>
        <StoreBadges tone="dark" />
        <p class="text-xs text-ink-400">{footerContent.availabilityNote}</p>
      </div>
    </div>

    <!--
      TODO: cuando existan páginas reales de Legal (términos, privacidad) y un
      canal de Contacto propio, o cuentas oficiales de redes sociales, agregar
      sus columnas aquí siguiendo el mismo patrón. Hoy no se renderizan vacías
      para no mostrar una UI que parezca rota.
    -->

    <div class="border-t border-border pt-6">
      <p class="text-xs text-ink-400">
        © {year} fiao. {footerContent.copyright}
      </p>
    </div>
  </div>
</footer>
