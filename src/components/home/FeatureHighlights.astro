---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import IconBubble from "@/components/ui/IconBubble.astro";
import { featureHighlights } from "@/data/landing";
import { pressable } from "@/lib/ui";
---

<section id="funciones" class="py-20 sm:py-28 bg-ink-50">
  <div class="container flex flex-col gap-14">
    <SectionHeading
      eyebrow="Funciones"
      title="Todo lo que necesitas para llevar el fiado"
      description="Nada de más, nada de menos: lo que un negocio de barrio necesita para no perderle la pista a lo que le deben."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        featureHighlights.map((feature) => (
          <div class={`flex flex-col gap-4 p-7 rounded-2xl bg-surface border border-border hover:shadow-md ${pressable}`} data-reveal>
            <IconBubble icon={feature.icon} />
            <h3 class="text-lg font-bold text-ink-900">{feature.title}</h3>
            <p class="text-ink-500 leading-relaxed">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
