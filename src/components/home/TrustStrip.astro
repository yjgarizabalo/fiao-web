---
import IconBubble from "@/components/ui/IconBubble.astro";
import { trustStripItems } from "@/data/landing";
---

<section class="py-12 sm:py-14 border-b border-border">
  <div class="container">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">
      {
        trustStripItems.map((item) => (
          <div class="flex items-start gap-4" data-reveal>
            <IconBubble icon={item.icon} size="md" />
            <div class="flex flex-col gap-1">
              <h3 class="font-bold text-ink-900">{item.title}</h3>
              <p class="text-sm text-ink-500 leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
