---
/**
 * Botón "volver arriba". Antes era una isla de React (client:idle) — era lo último que
 * obligaba a bajar React en la página. Ahora es un <button> real con un script mínimo.
 * Aparece después de bajar 600 px y respeta el movimiento reducido (scroll instantáneo).
 */
import Icon from "@/components/ui/Icon.astro";
---

<button
  id="scroll-top"
  type="button"
  class="press press-icon fixed right-4 bottom-4 z-40 inline-flex h-12 w-12 translate-y-4 items-center justify-center rounded-full bg-ink-900 text-white opacity-0 shadow-lg pointer-events-none sm:right-6 sm:bottom-6"
  aria-label="Volver arriba"
  tabindex="-1"
>
  <Icon name="arrow-up" size={20} />
</button>

<style>
  #scroll-top {
    transition:
      opacity var(--duration-normal) var(--ease-snappy),
      transform var(--duration-normal) var(--ease-snappy);
    margin-bottom: env(safe-area-inset-bottom);
  }
  #scroll-top[data-visible="true"] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
</style>

<script>
  const button = document.getElementById("scroll-top");
  if (button) {
    let ticking = false;
    const update = () => {
      const visible = window.scrollY > 600;
      button.dataset.visible = String(visible);
      // Solo entra al orden de tabulación cuando se ve.
      button.tabIndex = visible ? 0 : -1;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    button.addEventListener("click", () => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      document.getElementById("contenido")?.focus({ preventScroll: true });
    });
    update();
  }
</script>
