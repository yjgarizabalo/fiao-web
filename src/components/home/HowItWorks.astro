---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { howItWorksSteps } from "@/data/landing";

// Los mismos pasos que se ven en pantalla alimentan el HowTo: nunca pueden desincronizarse.
const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "Cómo funciona fiao",
  description:
    "Los tres pasos para dejar de fiar en cuaderno y llevar el fiado de tu negocio desde el celular.",
  step: howItWorksSteps.map((step) => ({
    "@type": "HowToStep",
    name: step.title,
    text: step.description,
  })),
};
---

<section id="como-funciona" class="py-20 sm:py-28">
  <div class="container flex flex-col gap-14">
    <SectionHeading
      eyebrow="Cómo funciona"
      title="Tres pasos, sin cuaderno de por medio"
      description="Fiao acompaña el día a día del negocio: rápido cuando estás atendiendo, claro cuando quieres revisar cuentas."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        howItWorksSteps.map((step) => (
          <div class="flex flex-col gap-4 p-8 rounded-3xl border border-border bg-surface-muted" data-reveal>
            <span class="text-brand-500 text-money-hero font-extrabold">{step.number}</span>
            <h3 class="text-xl font-bold text-ink-900">{step.title}</h3>
            <p class="text-ink-500 leading-relaxed">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} is:inline />
