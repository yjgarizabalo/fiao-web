---
/**
 * Pill de estado — mismo patrón que Badge en fiao-mobil: fondo de tono suave
 * + texto del mismo tono, siempre con texto visible junto al color (nunca
 * solo color, por accesibilidad — misma regla que el componente original).
 */
export interface Props {
  tone?: "brand" | "neutral" | "inverse";
  class?: string;
}

const { tone = "brand", class: className = "" } = Astro.props;

const toneClass = {
  brand: "bg-brand-50 text-brand-700",
  neutral: "bg-ink-100 text-ink-700",
  inverse: "bg-white/10 text-ink-0 border border-white/15",
}[tone];
---

<span class={`inline-flex items-center gap-1.5 rounded-pill px-3.5 py-1.5 text-sm font-semibold ${toneClass} ${className}`}>
  <slot />
</span>
