---
/**
 * Badge — pill de estado de fiao-mobil (src/ui/Badge.tsx): fondo suave + texto del mismo
 * tono, siempre con texto (nunca solo color). sm usa la variante overline de la app;
 * md, captionStrong. Tonos web ajustados a AA (ver cabecera de global.css).
 */
import Icon from "./Icon.astro";
import type { IconName } from "@/lib/icons";

export type BadgeTone = "neutral" | "success" | "warning" | "danger" | "info" | "brand" | "inverse";

export interface Props {
  tone?: BadgeTone;
  size?: "sm" | "md";
  icon?: IconName;
  class?: string;
}

const { tone = "neutral", size = "md", icon, class: className = "" } = Astro.props;

const toneClass: Record<BadgeTone, string> = {
  neutral: "bg-ink-100 text-ink-600",
  success: "bg-brand-50 text-brand-700",
  warning: "bg-warning-50 text-warning-800",
  danger: "bg-danger-50 text-danger-600",
  info: "bg-info-50 text-info-600",
  brand: "bg-brand-500 text-ink-900",
  inverse: "bg-white/10 text-white ring-1 ring-inset ring-white/15",
};

const sizeClass = {
  sm: "gap-1 px-2 py-[3px] text-overline uppercase",
  md: "gap-1 px-3 py-1.5 text-caption font-semibold",
}[size];
---

<span class={`inline-flex items-center whitespace-nowrap rounded-pill ${sizeClass} ${toneClass[tone]} ${className}`}>
  {icon && <Icon name={icon} size={size === "sm" ? 11 : 13} />}
  <slot />
</span>
