---
/**
 * IconBubble — calco de fiao-mobil (src/ui/Layout.tsx): cuadrado redondeado con radio
 * size/3.2 (el "squircle" de la app, no un círculo) e ícono al 46 % del tamaño.
 * Así una tarjeta de la web se lee igual que una quick-action de la pantalla de Inicio.
 */
import Icon from "./Icon.astro";
import type { IconName } from "@/lib/icons";

export type IconBubbleTone = "neutral" | "brand" | "danger" | "warning" | "info" | "inverse";

export interface Props {
  icon: IconName;
  tone?: IconBubbleTone;
  /** Tamaño en px. La app usa 40 y 44 (default). */
  size?: number;
  class?: string;
}

const { icon, tone = "brand", size = 44, class: className = "" } = Astro.props;

// Fondo suave + ícono del mismo tono (el tono "Strong" de la app).
const toneClass: Record<IconBubbleTone, string> = {
  neutral: "bg-ink-100 text-ink-500",
  brand: "bg-brand-50 text-brand-600",
  danger: "bg-danger-50 text-danger-600",
  warning: "bg-warning-50 text-warning-600",
  info: "bg-info-50 text-info-600",
  inverse: "bg-white/10 text-brand-300 ring-1 ring-inset ring-white/15",
};

const radius = Math.round((size / 3.2) * 10) / 10;
const iconSize = Math.round(size * 0.46);
---

<span
  class={`inline-flex items-center justify-center shrink-0 ${toneClass[tone]} ${className}`}
  style={`width:${size}px;height:${size}px;border-radius:${radius}px`}
>
  <Icon name={icon} size={iconSize} />
</span>
