---
/**
 * Set mínimo de íconos en SVG plano (sin lucide-react) para que las
 * secciones estáticas no paguen el costo de una isla de React solo por un
 * ícono.
 */
export interface Props {
  name: "users" | "wallet" | "store" | "message-circle" | "list" | "shield-check" | "smartphone";
  class?: string;
}

const { name, class: className = "w-6 h-6" } = Astro.props;

const paths: Record<Props["name"], string> = {
  users:
    "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75",
  wallet:
    "M21 12V7H5a2 2 0 0 1 0-4h14v4 M3 5v14a2 2 0 0 0 2 2h16v-5 M18 12a2 2 0 0 0 0 4h3v-4h-3z",
  store:
    "M3 9l1-5h16l1 5 M3 9a2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 2 2 0 0 0 4 0 M4 9v10h16V9 M9 21v-6h6v6",
  "message-circle":
    "M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z",
  list: "M8 6h13 M8 12h13 M8 18h13 M3 6h.01 M3 12h.01 M3 18h.01",
  "shield-check":
    "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4",
  smartphone: "M7 2h10v20H7z M12 18h.01",
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].split(" M").map((segment, i) => <path d={i === 0 ? segment : `M${segment}`} />)}
</svg>
