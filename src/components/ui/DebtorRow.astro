---
/**
 * DebtorRow — fila de cliente de fiao-mobil (src/features/debtors/components/DebtorRow.tsx):
 * avatar con punto de estado, nombre y teléfono; a la derecha el saldo en rojo con
 * "debe" debajo, o el badge "Al día" si no debe nada.
 */
import Avatar from "./Avatar.astro";
import Badge from "./Badge.astro";
import { formatMoney } from "@/lib/format";

export interface Props {
  name: string;
  phone?: string;
  balance: number;
  overdue?: boolean;
  class?: string;
}

const { name, phone, balance, overdue = false, class: className = "" } = Astro.props;
const owes = balance > 0;
---

<div class={`flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 ${className}`}>
  <Avatar name={name} status={owes ? (overdue ? "overdue" : "debt") : "clear"} />
  <div class="flex min-w-0 flex-1 flex-col">
    <span class="truncate text-body font-semibold text-text">{name}</span>
    {phone && <span class="tabular text-caption text-text-muted">{phone}</span>}
  </div>
  {
    owes ? (
      <div class="flex flex-col items-end">
        <span class="tabular text-money font-bold text-danger-600">{formatMoney(balance)}</span>
        <span class="text-overline uppercase text-text-muted">debe</span>
      </div>
    ) : (
      <Badge tone="success" icon="checkmark-circle">Al día</Badge>
    )
  }
</div>
