---
/**
 * Botones de descarga con estilo propio (no son las imágenes oficiales de
 * Apple/Google, que no podemos redistribuir): un ícono simple + el nombre de
 * cada tienda, en dos tonos según el fondo donde se usen.
 */
import { storeLinks } from "@/data/landing";

export interface Props {
  tone?: "dark" | "light";
}

const { tone = "dark" } = Astro.props;

const badgeClass =
  tone === "dark"
    ? "bg-ink-900 text-ink-0 hover:bg-ink-800"
    : "bg-ink-0 text-ink-900 hover:bg-ink-50 border border-border";
---

<div class="flex flex-wrap items-center gap-3">
  <a
    href={storeLinks.ios}
    class={`flex items-center gap-2.5 rounded-xl px-5 py-3 transition-colors ${badgeClass}`}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M16.365 1.43c0 1.14-.464 2.096-1.192 2.884-.827.884-2.147 1.606-3.32 1.51-.14-1.18.444-2.386 1.192-3.155.83-.86 2.276-1.51 3.32-1.24zM20.11 17.24c-.518 1.155-.766 1.67-1.436 2.68-.937 1.407-2.256 3.157-3.895 3.17-1.454.014-1.83-.945-3.807-.935-1.976.01-2.392.95-3.848.936-1.638-.014-2.887-1.6-3.826-3.006C1.02 17.02.2 12.24 2.44 8.9c1.15-1.71 2.998-2.79 4.75-2.79 1.784 0 2.906.99 4.383.99 1.43 0 2.302-.99 4.383-.99 1.6 0 3.29.87 4.5 2.375-3.955 2.17-3.312 7.82.654 8.755z"
      ></path>
    </svg>
    <span class="text-left leading-tight">
      <span class="block text-[10px] opacity-80">Disponible en</span>
      <span class="block text-sm font-semibold">App Store</span>
    </span>
  </a>

  <a
    href={storeLinks.android}
    class={`flex items-center gap-2.5 rounded-xl px-5 py-3 transition-colors ${badgeClass}`}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M3.6 2.4c-.35.2-.6.55-.6.98v17.24c0 .43.25.78.6.98l10.35-9.6L3.6 2.4zm12.02 10.02 2.77-1.6c.77-.44.77-1.55 0-2l-2.77-1.6-2.5 2.6 2.5 2.6zM5.13 21.5l9.34-8.66-9.34-8.66c-.15.2-.24.44-.24.72v16.88c0 .28.09.52.24.72z"
      ></path>
    </svg>
    <span class="text-left leading-tight">
      <span class="block text-[10px] opacity-80">Disponible en</span>
      <span class="block text-sm font-semibold">Google Play</span>
    </span>
  </a>
</div>
