---
/**
 * En el mostrador — los bloques alternados de tyba (texto / imagen, imagen / texto),
 * con dos piezas reales de la app en lugar de fotos:
 *  1. La hoja "Agregar deuda" (fiao-mobil/src/features/debts/components/AddDebtSheet.tsx).
 *  2. El recordatorio de WhatsApp, con el texto exacto que arma la app
 *     (fiao-mobil/src/core/utils/whatsapp.ts).
 * El segundo bloque repite el CTA de descarga, como tyba en sus bloques de producto.
 */
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { inStoreContent, whatsappExample, heroContent } from "@/data/landing";
import { formatMoney } from "@/lib/format";

const { fiar, cobrar } = inStoreContent;
const balance = formatMoney(whatsappExample.balance);
---

<section id="en-la-tienda" aria-labelledby="en-la-tienda-title" class="bg-bg py-16 sm:py-24">
  <div class="container flex flex-col gap-16 sm:gap-24">
    <SectionHeading id="en-la-tienda-title" eyebrow={inStoreContent.eyebrow} title={inStoreContent.title} />

    <!-- Bloque 1: texto a la izquierda, hoja de la app a la derecha -->
    <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-20" aria-labelledby="fiar-title">
      <div class="flex flex-col gap-5" data-reveal>
        <h3 id="fiar-title" class="text-title-1 font-extrabold sm:text-display">{fiar.title}</h3>
        <p class="text-lead text-text-muted">{fiar.description}</p>
        <ul class="flex flex-col gap-3">
          {
            fiar.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-body-lg">
                <Icon name="checkmark-circle" size={22} class="mt-px text-brand-500" />
                {bullet}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mx-auto w-full max-w-[400px]" aria-hidden="true" data-reveal>
        <div class="rounded-t-3xl rounded-b-2xl bg-surface shadow-xl ring-1 ring-border">
          <div class="flex justify-center pt-3 pb-1"><span class="h-1 w-10 rounded-full bg-ink-200"></span></div>
          <div class="flex items-start justify-between px-5 pt-2 pb-3">
            <div>
              <p class="text-title-3 font-semibold text-text">Agregar deuda</p>
              <p class="text-caption text-text-muted">A nombre de María Pérez</p>
            </div>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink-100 text-text-muted">
              <Icon name="close" size={18} />
            </span>
          </div>
          <div class="flex flex-col gap-4 px-5 pb-5">
            <div>
              <p class="mb-1.5 text-caption font-semibold text-text-muted">¿Cuánto le vas a fiar?</p>
              <div class="flex items-baseline gap-1.5 rounded-2xl border-[1.5px] border-brand-500 bg-surface px-5 py-4">
                <span class="text-title-1 font-bold text-text/70">$</span>
                <span class="tabular text-title-1 font-extrabold text-text-strong">18.500</span>
              </div>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {
                ["+$2.000", "+$5.000", "+$10.000", "+$20.000"].map((chip) => (
                  <span class="rounded-pill border border-border px-3 py-1.5 text-caption font-semibold text-text">{chip}</span>
                ))
              }
            </div>
            <div>
              <p class="mb-1.5 text-caption font-semibold text-text-muted">¿Cuándo te lo paga?</p>
              <div class="grid grid-cols-4 rounded-pill bg-ink-100 p-1 text-center text-caption font-semibold">
                <span class="py-2 text-text-muted">Sin plazo</span>
                <span class="py-2 text-text-muted">8 días</span>
                <span class="rounded-pill bg-surface py-2 text-brand-text shadow-xs">15 días</span>
                <span class="py-2 text-text-muted">30 días</span>
              </div>
              <p class="mt-2 inline-flex items-center gap-1.5 text-caption text-text-muted">
                <Icon name="calendar-outline" size={14} /> Vence el 9 de octubre
              </p>
            </div>
            <span class="inline-flex h-14 items-center justify-center rounded-lg bg-brand-500 text-body-lg font-bold text-ink-900 shadow-sm">
              Fiar $ 18.500
            </span>
          </div>
        </div>
      </div>
    </article>

    <!-- Bloque 2: chat de WhatsApp a la izquierda, texto a la derecha -->
    <article class="grid items-center gap-10 lg:grid-cols-2 lg:gap-20" aria-labelledby="cobrar-title">
      <div class="order-2 mx-auto w-full max-w-[400px] lg:order-1" aria-hidden="true" data-reveal>
        <div class="overflow-hidden rounded-3xl shadow-xl ring-1 ring-border">
          <div class="flex items-center gap-3 bg-[#075E54] px-4 py-3 text-white">
            <Icon name="chevron-forward" size={18} class="rotate-180 opacity-80" />
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/20 text-caption font-bold">MP</span>
            <div class="flex flex-col leading-tight">
              <span class="text-body font-semibold">{whatsappExample.client} Pérez</span>
              <span class="text-caption text-white/70">en línea</span>
            </div>
            <Icon name="logo-whatsapp" size={20} class="ml-auto opacity-90" />
          </div>
          <div class="wa-wallpaper flex min-h-[260px] flex-col justify-end gap-2 px-4 py-5">
            <div class="ml-auto max-w-[88%] rounded-xl rounded-tr-sm bg-[#D9FDD3] px-3.5 py-2.5 text-body text-[#111B21] shadow-xs">
              <p>Hola {whatsappExample.client} 👋 Le escribo de <strong>{whatsappExample.business}</strong>.</p>
              <p class="mt-2">
                Le recuerdo con todo el aprecio que tiene un saldo pendiente de <strong class="tabular">{balance}</strong>.
              </p>
              <p class="mt-2">Cuando pueda me avisa para coordinar el pago. ¡Muchas gracias!</p>
              <p class="mt-1 text-right text-[11px] text-[#667781]">9:41 ✓✓</p>
            </div>
          </div>
        </div>
      </div>

      <div class="order-1 flex flex-col gap-5 lg:order-2" data-reveal>
        <h3 id="cobrar-title" class="text-title-1 font-extrabold sm:text-display">{cobrar.title}</h3>
        <p class="text-lead text-text-muted">{cobrar.description}</p>
        <ul class="flex flex-col gap-3">
          {
            cobrar.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-body-lg">
                <Icon name="checkmark-circle" size={22} class="mt-px text-brand-500" />
                {bullet}
              </li>
            ))
          }
        </ul>
        <div class="pt-2">
          <Button href={heroContent.primaryCta.href} size="lg" iconRight="chevron-forward">{heroContent.primaryCta.label}</Button>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  /* Fondo del chat de WhatsApp: el beige claro de la app, sin imagen. */
  .wa-wallpaper {
    background-color: #efeae2;
  }
</style>
