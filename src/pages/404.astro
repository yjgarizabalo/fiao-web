---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página no encontrada" description="Esta página no existe en fiao." noindex>
  <section class="min-h-[70vh] flex items-center justify-center py-24">
    <div class="container flex flex-col items-center text-center gap-5">
      <span class="text-money-hero font-extrabold text-brand-500">404</span>
      <h1 class="text-title-1 font-bold text-ink-900">Esta página se perdió, como una hoja del cuaderno</h1>
      <p class="text-ink-500 max-w-md">
        El enlace que seguiste no existe o cambió de lugar. Vuelve al inicio para seguir conociendo fiao.
      </p>
      <a
        href="/"
        class="mt-2 bg-primary text-primary-foreground rounded-pill font-semibold py-3 px-8 hover:bg-brand-600 transition-colors"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
